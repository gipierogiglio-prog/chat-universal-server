# Used by docker-compose (copy to .env and change the values)
POSTGRES_PASSWORD=chat
JWT_SECRET=change-me-to-a-long-random-string
HERMES_API_KEY=hermes-secret-key
OPENCLAW_API_KEY=openclaw-secret-key
# Hermes gateway's inbound endpoint (chat_universal plugin adapter).
# Must match CHAT_UNIVERSAL_LISTEN_PORT / HERMES_API_KEY must match
# CHAT_UNIVERSAL_API_KEY on the Hermes side.
HERMES_WEBHOOK_URL=http://172.17.0.1:8645/inbound
